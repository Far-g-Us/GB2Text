{
  "game": {
    "name": "Шаблон GB/GBC игры",
    "version": "2.0.0",
    "description": "Шаблон для игр Game Boy / Game Boy Color с ASCII текстом"
  },
  "supported_platforms": ["GB", "GBC"],
  "header_pattern": {
    "entry_point_offset": 256,
    "logo_offset": 260,
    "title_offset": 308,
    "cgb_flag_offset": 323
  },
  "extraction_modes": {
    "ascii": {
      "description": "Простой ASCII текст",
      "terminators": ["0x50", "0xFF"],
      "min_length": 5
    },
    "pokemon_gen1": {
      "description": "Pokemon Gen 1/2 с 2-байтовыми указателями",
      "terminators": ["0x50"],
      "pointer_size": 2,
      "bank_switching": true
    }
  },
  "segments": [
    {
      "name": "dialogue",
      "start": "0x4000",
      "end": "0x7FFF",
      "encoding": "ascii",
      "terminators": ["0x50", "0xFF"],
      "min_length": 5,
      "charmap": {
        "0x20-0x7E": "ASCII",
        "0x50": "END (Pokemon)"
      }
    }
  ],
  "validation": {
    "min_alpha_ratio": 0.3,
    "max_unknown_bytes": 0.2
  }
}
