{
  "disclaimer": "Эта конфигурация предназначена ТОЛЬКО для домашних (homebrew) игр, созданных вами самостоятельно.",
  "game_id_pattern": "^HOME_BREW_[A-Z0-9]+_[0-9A-F]{2}$",
  "description": "Пример конфигурации для homebrew GBA игры с ASCII текстом",
  "platform": "GBA",
  "segments": [
    {
      "name": "main_text",
      "start": "0x4000",
      "end": "0x7FFF",
      "encoding": "ascii",
      "terminators": ["0x00"],
      "min_length": 5,
      "charmap": {
        "0x20": " ",
        "0x21": "!",
        "0x22": "\"",
        "0x2C": ",",
        "0x2D": "-",
        "0x2E": ".",
        "0x30-0x39": "0-9",
        "0x41-0x5A": "A-Z",
        "0x61-0x7A": "a-z",
        "0xFF": "END"
      }
    },
    {
      "name": "dialogue",
      "start": "0x8000",
      "end": "0xBFFF",
      "encoding": "ascii_with_control_codes",
      "terminators": ["0x0D", "0xFF"],
      "control_codes": {
        "0x0A": "\\n",
        "0x06": "\\n"
      },
      "min_length": 3,
      "charmap": {
        "0x20-0x7E": "ASCII printable",
        "0x0A": "\\n",
        "0x06": "\\n",
        "0xFF": "END"
      }
    }
  ],
  "validation": {
    "min_alpha_ratio": 0.3,
    "max_unknown_bytes": 0.2,
    "check_terminators": true
  },
  "tips": [
    "Используйте диапазоны для обозначения множества кодов (0x41-0x5A = A-Z)",
    "Контрольные коды (0x06, 0x0A) не являются текстом — они обрабатываются отдельно",
    "min_length фильтрует мусорные строки (адреса, случайные байты)"
  ]
}
