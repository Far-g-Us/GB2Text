{
  "game": {
    "name": "Шаблон GBC игры",
    "version": "2.0.0",
    "description": "Шаблон для игр Game Boy Color с расширенной кодировкой"
  },
  "supported_platforms": ["GBC", "GB"],
  "header_pattern": {
    "entry_point_offset": 256,
    "logo_offset": 260,
    "title_offset": 272,
    "cgb_flag_offset": 323
  },
  "features": {
    "color_support": true,
    "ram_banks": [0, 1, 2, 4, 8]
  },
  "extraction_modes": {
    "ascii": {
      "description": "ASCII текст",
      "terminators": ["0x50", "0xFF"]
    },
    "extended": {
      "description": "Расширенная латиница (акценты, спецсимволы)",
      "primary_range": ["0x80-0x9A"]
    }
  },
  "segments": [
    {
      "name": "dialogue",
      "start": "0x4000",
      "end": "0x7FFF",
      "encoding": "ascii",
      "terminators": ["0x50", "0xFF"],
      "min_length": 5,
      "charmap": {
        "0x20-0x7E": "ASCII",
        "0x80-0x9A": "Extended Latin",
        "0x50": "END"
      }
    }
  ],
  "validation": {
    "min_alpha_ratio": 0.3,
    "max_unknown_bytes": 0.2
  }
}
